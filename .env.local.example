NEWS_SEARCH_API_KEY=your-dashscope-api-key-here
NEWS_SEARCH_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Optional: default is qwen-plus
NEWS_SEARCH_MODEL=qwen-plus

# Vercel Blob: used for shared saved results.
# New Vercel Blob stores can use OIDC automatically after being connected.
# Local development falls back to data/saved-news.json when this is empty.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# Required for updating/searching/saving shared results.
MANAGEMENT_PASSWORD=your-management-password

# API_KEY 只能在服务端读取，不要使用 NEXT_PUBLIC_API_KEY。
# 任何以 NEXT_PUBLIC_ 开头的变量都会暴露给浏览器，不能用于敏感密钥。
